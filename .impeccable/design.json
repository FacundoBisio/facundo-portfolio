  "narrative": {
    "northStar": "The Working Notebook",
    "overview": "A dark, editorial page that reads like the notes of someone who builds things: a serif voice for the statements, a plain sans for the explanation, and a mono for the facts. It is quiet on purpose. The products shown inside it are the loud part.",
    "keyCharacteristics": [
      "Dark only. Warm, slightly green near-black; never pure black, never pure white.",
      "One accent (lime). It marks the single most important thing in view.",
      "Serif display with a true italic; sans body; mono for facts.",
      "Square corners and 1px hairlines; depth by tone, not by shadow.",
      "Product media is the only large imagery."
    ],
    "rules": [
      {
        "name": "The One Lime Rule",
        "body": "Lime covers no more than a tenth of any screen. If two lime things are visible at once, one of them is wrong.",
        "section": "colors"
